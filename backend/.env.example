ENVIRONMENT=development
DATABASE_URL=sqlite:///./graded_reader.db
JWT_SECRET=development-secret-change-me-please
# Set this to generate readings directly with OpenAI. Keep it on the backend only.
# OPENAI_API_KEY=replace-with-your-openai-api-key
# To use KI:connect's OpenAI-compatible API, set these values instead:
# MODEL_PROVIDER=kiconnect
# BASE_URL=https://chat.kiconnect.nrw/api/v1
# KICONNECT_API_KEY=replace-with-your-kiconnect-api-key
# GENERATION_DEFAULT_MODEL=GPT5-mini-Studierende
# Or set both variables to use a compatible custom generation provider.
# GENERATION_PROVIDER_URL=https://provider.example/readings
# GENERATION_PROVIDER_TOKEN=replace-with-a-secret
GENERATION_DEFAULT_MODEL=GPT5-mini-Studierende
GENERATION_TIMEOUT_SECONDS=120
# Register for an API key with the National Institute of Korean Language's Open Dictionary,
# then set it here to fetch normal Korean dictionary definitions for words outside your vocabulary.
# KOREAN_DICTIONARY_API_KEY=replace-with-your-open-dictionary-key
# KOREAN_DICTIONARY_URL=https://opendict.korean.go.kr/api/search
DICTIONARY_TIMEOUT_SECONDS=20
